# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# -----------------------------------------------------------------------------
# Server-only (never exposed to the browser)
# -----------------------------------------------------------------------------

# Vercel Postgres connection string. Required for order/waitlist submissions
# (POST /api/orders) and the game leaderboard; those features fail gracefully
# without it. Vercel sets this automatically when a Postgres store is linked.
# POSTGRES_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional. Bearer token (min 16 chars) for admin-only endpoints such as
# GET /api/orders. When unset, those endpoints are disabled (404).
# Generate one with: openssl rand -hex 32
# ADMIN_API_KEY="replace-with-a-long-random-secret"

# -----------------------------------------------------------------------------
# Client-exposed (NEXT_PUBLIC_*) — bundled into browser JavaScript
# -----------------------------------------------------------------------------

# Optional. Bare Shopify store hostname (no protocol), e.g.
# "your-store.myshopify.com". Enables live products and the Shopify cart.
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# Optional. PUBLIC Storefront API access token (never an Admin API token).
# Without it the site falls back to the tokenless Storefront API.
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN="your-public-storefront-access-token"
